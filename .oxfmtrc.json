{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".reference", ".plans", "dist", "node_modules", "bun.lock", ".docs"],
  "sortPackageJson": {},
  "overrides": [],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": true
}
